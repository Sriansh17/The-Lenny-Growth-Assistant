# The Lenny Growth Assistant - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# APP SETTINGS
# ===========================================
APP_NAME="The Lenny Growth Assistant"
APP_VERSION="1.0.0"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ===========================================
# DATABASE (PostgreSQL with pgvector)
# ===========================================
# Local Docker Compose default:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant

# For Supabase (replace with your credentials):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxx.supabase.co:5432/postgres

# For Railway (replace with your credentials):
# DATABASE_URL=postgresql+asyncpg://postgres:password@containers-us-west-xxx.railway.app:5432/railway

DATABASE_ECHO=false

# ===========================================
# VECTOR DATABASE (ChromaDB)
# ===========================================
VECTOR_DB_PATH=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ===========================================
# LLM CONFIGURATION
# ===========================================
# Provider: ollama, anthropic, or openai
LLM_PROVIDER=ollama

# Cloud LLM Keys (optional - required if using cloud providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Cloud Model (used when provider is anthropic or openai)
CLOUD_MODEL=claude-3-5-sonnet-20241022

# Model Parameters
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=4096

# ===========================================
# RAG CONFIGURATION
# ===========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7

# ===========================================
# SESSION
# ===========================================
SESSION_TTL_HOURS=24

# ===========================================
# SECURITY
# ===========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ===========================================
# OBSERVABILITY
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=console